# /api/match-intent 라우트(app/api/match-intent/route.ts)가 서버에서 사용.
# 이 값이 없으면 실시간 미팅 화면은 자동으로 mock 판단 로직으로 폴백한다 (데모는 안 끊김).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 선택 (기본값 gpt-4o)
OPENAI_MODEL=gpt-4o

# Agora Console > 프로젝트에서 발급. AGORA_APP_CERTIFICATE는 RTC 토큰 서명에 쓰이는
# 비밀값이라 절대 NEXT_PUBLIC_ 접두어를 붙이거나 클라이언트 코드에 노출하면 안 됨.
# 서버 라우트(예: /api/agora-token)에서만 사용할 것.
AGORA_APP_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AGORA_APP_CERTIFICATE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Conversational AI Agent를 RTC 채널에 join시키는 REST API용 (Basic Auth).
# Agora Console에서 Customer ID/Secret 발급 필요 (구버전 문서 기준 "Developer Toolkit >
# RESTful API"인데, 리뉴얼된 콘솔에서는 위치가 다를 수 있음 — 계정 설정 쪽도 확인해볼 것).
AGORA_CUSTOMER_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AGORA_CUSTOMER_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Agora Console > Agents > tkzr > Embed Agent에서 복사한 pipeline_id.
# Agent의 프롬프트/모델/Custom Tool 설정을 통째로 참조하는 키.
AGORA_AGENT_PIPELINE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Custom LLM 엔드포인트(app/api/agora-tool/chat-completions)의 공개 주소.
# Agora Agent가 이 서버를 직접 호출하므로 public URL이어야 함 (로컬 개발 중엔 cloudflared
# 같은 터널 필요 — 터널 주소가 바뀔 때마다 이 값도 갱신하고 서버 재시작할 것).
AGORA_PUBLIC_BASE_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.trycloudflare.com
